{
  "manifest_version": 3,
  "name": "tldv capture",
  "version": "1.0.0",
  "description": "Captures every media URL and playlist body the tl;dv player touches.",
  "permissions": ["webRequest", "storage", "downloads"],
  "host_permissions": [
    "https://*.tldv.io/*",
    "https://media-files.tldv.io/*"
  ],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["https://*.tldv.io/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://*.tldv.io/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}
